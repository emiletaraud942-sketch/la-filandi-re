# Injectée automatiquement par Vercel dès qu'une base Postgres est reliée au
# projet (Storage → Create Database → Postgres). Rien à faire manuellement.
POSTGRES_URL=

# À générer et renseigner vous-même dans les réglages du projet Vercel
# (Settings → Environment Variables). Valeur aléatoire d'au moins 32
# caractères — par exemple générée avec : openssl rand -base64 32
SESSION_SECRET=
