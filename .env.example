# Injectée automatiquement par Vercel dès qu'une base est reliée au projet
# (Storage → Marketplace Database Providers → Neon). Le nom exact dépend de
# l'intégration : lib/db.ts accepte POSTGRES_URL, DATABASE_URL,
# POSTGRES_URL_NO_SSL ou POSTGRES_URL_NON_POOLING — rien à renommer à la main.
DATABASE_URL=

# À générer et renseigner vous-même dans les réglages du projet Vercel
# (Settings → Environment Variables). Valeur aléatoire d'au moins 32
# caractères — par exemple générée avec : openssl rand -base64 32
# ATTENTION : le nom doit être exactement SESSION_SECRET (majuscules) —
# Vercel/Node ne reconnaît pas session_secret en minuscules.
SESSION_SECRET=
